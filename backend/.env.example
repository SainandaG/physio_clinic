# Backend environment configuration
# Copy this to .env and fill in your values

DB_HOST=localhost
DB_PORT=5432
DB_NAME=srini_physio
DB_USER=postgres
DB_PASSWORD=change-me
# Or a single connection string (used instead of the DB_* values above when set):
